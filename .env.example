# Hardcover API token from https://hardcover.app/account/api
# Tokens expire every January 1st. Only needed by the seeder and the /ui
# console's hardcover comparison column; serving works without it.
HARDCOVER_TOKEN=

# Search results must have at least this many ratings, unless nothing else
# matches the query. Filters junk imports and box-set stubs.
RMP_SEARCH_MIN_RATINGS=5

# Edition language codes search results may have (comma-separated, ISO
# 639-1). Empty disables the filter. Queries in non-Latin script bypass it.
RMP_SEARCH_LANGUAGES=en

# Every serve flag can be set here as RMP_<FLAG> (RMP_ADDR, RMP_DB,
# RMP_DATASET_URL, RMP_DATASET_REFRESH, RMP_WEB, ...). Flags win over the
# environment. The server reads this file from its working directory.
